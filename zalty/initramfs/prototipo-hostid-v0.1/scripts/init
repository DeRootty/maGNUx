#!/bin/sh
# =============================================================
# maGNUx initramfs — init
# Stratified boot: ROOT → COMM → ADMIN
#
# Each stratum is explicit and sequential.
# The foundation (ROOT) does not disappear after pivot_root.
# =============================================================

IDENTITY_PATH="/dev/shm/magnux-host-identity"
COMM_PATH="/dev/shm/magnux-early-comm"
POLICY_PATH="/etc/dernel/policy.conf"
REAL_ROOT="/mnt/real-root"
LOG_TAG="[maGNUx init]"

log() {
    echo "$LOG_TAG $1" > /dev/kmsg 2>/dev/null || echo "$LOG_TAG $1"
}

die() {
    log "FATAL: $1"
    exec /bin/sh  # emergency shell
}

# =============================================================
# STRATUM ROOT — structural authority
# Establishes hardware, memory, minimal devices, host identity.
# Nothing from userspace runs here.
# =============================================================
stratum_root() {
    log "=== STRATUM ROOT ==="

    # Mount essential virtual filesystems
    mount -t proc  none /proc  || die "cannot mount /proc"
    mount -t sysfs none /sys   || die "cannot mount /sys"
    mount -t devtmpfs none /dev 2>/dev/null || \
        mount -t tmpfs none /dev

    # /dev/shm — persistent memory region for identity + comm
    mkdir -p /dev/shm
    mount -t tmpfs -o size=4m,mode=0700 tmpfs /dev/shm \
        || die "cannot mount /dev/shm"

    log "Virtual filesystems mounted"

    # --- xGNUpeD: establish host identity ---
    log "xGNUpeD: establishing host identity..."

    if [ -x /sbin/xgnuped-init ]; then
        /sbin/xgnuped-init "$IDENTITY_PATH"
        [ $? -eq 0 ] || die "xGNUpeD failed to establish identity"
        log "xGNUpeD: identity established at $IDENTITY_PATH"
    else
        # Prototype fallback: write minimal identity via shell
        log "xGNUpeD: binary not found, using shell fallback"
        _root_identity_fallback
    fi

    log "=== STRATUM ROOT complete ==="
}

# Shell fallback for host identity (until C binary is built)
_root_identity_fallback() {
    KERNEL_VER=$(uname -r 2>/dev/null || echo "unknown")
    DISTRO="maGNUx-prototype"
    TIMESTAMP=$(date +%s 2>/dev/null || echo "0")
    CONTEXT="unknown"

    # Detect VM context
    if grep -q "QEMU\|VirtualBox\|VMware" \
            /sys/class/dmi/id/product_name 2>/dev/null; then
        CONTEXT="vm"
    else
        CONTEXT="bare-metal"
    fi

    cat > "$IDENTITY_PATH" <<EOF
magnux_magic=GNUX
version=1
distro=$DISTRO
kernel=$KERNEL_VER
context=$CONTEXT
timestamp=$TIMESTAMP
EOF
    log "Identity fallback written: distro=$DISTRO kernel=$KERNEL_VER context=$CONTEXT"
}

# =============================================================
# STRATUM COMM — mediation and coherence
# Validates boot sequence, loads policy, establishes early IPC.
# =============================================================
stratum_comm() {
    log "=== STRATUM COMM ==="

    # Verify identity established in ROOT
    if [ ! -f "$IDENTITY_PATH" ]; then
        die "HOST IDENTITY NOT FOUND — ROOT stratum may have failed"
    fi
    log "COMM: host identity verified"

    # --- Dernel runtime: load boot policy ---
    log "Dernel runtime: loading boot policy..."

    if [ -x /sbin/dernel-runtime ]; then
        /sbin/dernel-runtime "$POLICY_PATH" "$IDENTITY_PATH" "$COMM_PATH"
        [ $? -eq 0 ] || log "WARNING: Dernel runtime returned error (permissive mode)"
    else
        log "Dernel runtime binary not found — permissive mode"
        # Write minimal comm marker
        echo "comm_ready=1" >> "$COMM_PATH"
    fi

    # Run udev / mdev for device nodes
    if [ -x /sbin/udevd ]; then
        log "COMM: starting udevd..."
        /sbin/udevd --daemon
        udevadm trigger --action=add 2>/dev/null
        udevadm settle 2>/dev/null
    elif [ -x /sbin/mdev ]; then
        log "COMM: using mdev..."
        echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null
        /sbin/mdev -s
    else
        log "COMM: no device manager found"
    fi

    log "=== STRATUM COMM complete ==="
}

# =============================================================
# STRATUM ADMIN — operational environment
# Mounts the real root, transfers control.
# Subordinate to ROOT, coordinated by COMM.
# =============================================================
stratum_admin() {
    log "=== STRATUM ADMIN ==="

    # --- Dernel guest: find and mount real root ---
    ROOT_DEV=""

    # Try kernel cmdline first
    for param in $(cat /proc/cmdline); do
        case "$param" in
            root=*) ROOT_DEV="${param#root=}" ;;
        esac
    done

    if [ -z "$ROOT_DEV" ]; then
        # Fallback: try common locations
        for dev in /dev/sda1 /dev/vda1 /dev/nvme0n1p1; do
            if [ -b "$dev" ]; then
                ROOT_DEV="$dev"
                break
            fi
        done
    fi

    if [ -z "$ROOT_DEV" ]; then
        log "WARNING: real root not found — dropping to emergency shell"
        exec /bin/sh
    fi

    log "ADMIN: mounting real root from $ROOT_DEV"
    mkdir -p "$REAL_ROOT"
    mount "$ROOT_DEV" "$REAL_ROOT" || die "cannot mount real root $ROOT_DEV"

    # --- Preserve identity across pivot_root ---
    # Copy identity and comm files to the real root's /dev/shm
    # so they survive after pivot_root
    mkdir -p "$REAL_ROOT/dev/shm"
    cp "$IDENTITY_PATH" "$REAL_ROOT$IDENTITY_PATH" 2>/dev/null \
        && log "ADMIN: identity preserved across pivot_root" \
        || log "ADMIN: WARNING — could not preserve identity"

    # Move virtual filesystems to new root
    for fs in proc sys dev; do
        mkdir -p "$REAL_ROOT/$fs"
        mount --move "/$fs" "$REAL_ROOT/$fs" 2>/dev/null \
            || mount --bind "/$fs" "$REAL_ROOT/$fs" 2>/dev/null
    done

    log "=== STRATUM ADMIN ready — switching root ==="

    # Pivot to real root
    cd "$REAL_ROOT"
    pivot_root . mnt/old-initramfs 2>/dev/null || \
        exec switch_root "$REAL_ROOT" /sbin/init

    # Execute real init
    exec /sbin/init "$@" || exec /bin/sh
}

# =============================================================
# Main sequence
# =============================================================
log "maGNUx initramfs starting — stratified boot"

stratum_root
stratum_comm
stratum_admin

# Should never reach here
die "Boot sequence ended unexpectedly"
