#!/bin/sh
# metal-inventory
# Zalty OS early technical inventory prototype
# Version: 0.1
#
# Purpose:
#   Inspect early Linux technical nodes from initramfs and emit a TOML-like
#   inventory that can later be compared against semantic nodes declared in
#   /boot/metal/.
#
# Scope v0.1:
#   - basic kernel identity
#   - essential /dev character nodes
#   - dangerous/high-authority /dev nodes
#   - block devices and stable disk links when available
#
# Design rule:
#   This script must keep working in small initramfs environments. It should
#   prefer POSIX shell and degrade gracefully when optional tools are missing.

set -eu

OUT="${1:-/run/metal/inventory/dev.toml}"
ROOT="${METAL_ROOT:-/}"

mkdir -p "$(dirname "$OUT")"

have_cmd() {
    command -v "$1" >/dev/null 2>&1
}

escape_toml() {
    # Minimal escaping for TOML string values.
    # shellcheck disable=SC2001
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

now_utc() {
    if have_cmd date; then
        date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf 'unknown'
    else
        printf 'unknown'
    fi
}

file_type() {
    path="$1"
    if [ -c "$path" ]; then
        printf 'char'
    elif [ -b "$path" ]; then
        printf 'block'
    elif [ -L "$path" ]; then
        printf 'symlink'
    elif [ -d "$path" ]; then
        printf 'directory'
    elif [ -e "$path" ]; then
        printf 'file'
    else
        printf 'missing'
    fi
}

file_mode() {
    path="$1"
    if have_cmd stat && [ -e "$path" ]; then
        stat -c '%a' "$path" 2>/dev/null || printf 'unknown'
    else
        printf 'unknown'
    fi
}

file_major() {
    path="$1"
    if have_cmd stat && { [ -c "$path" ] || [ -b "$path" ]; }; then
        stat -c '%t' "$path" 2>/dev/null | awk '{ printf "%d", "0x" $1 }' 2>/dev/null || printf 'unknown'
    else
        printf 'unknown'
    fi
}

file_minor() {
    path="$1"
    if have_cmd stat && { [ -c "$path" ] || [ -b "$path" ]; }; then
        stat -c '%T' "$path" 2>/dev/null | awk '{ printf "%d", "0x" $1 }' 2>/dev/null || printf 'unknown'
    else
        printf 'unknown'
    fi
}

emit_node() {
    id="$1"
    path="$2"

    type="$(file_type "$path")"
    exists=false
    [ "$type" != "missing" ] && exists=true

    mode="$(file_mode "$path")"
    major="$(file_major "$path")"
    minor="$(file_minor "$path")"

    printf '\n[dev."%s"]\n' "$id"
    printf 'path = "%s"\n' "$(escape_toml "$path")"
    printf 'exists = %s\n' "$exists"
    printf 'type = "%s"\n' "$type"
    printf 'mode = "%s"\n' "$mode"
    printf 'major = "%s"\n' "$major"
    printf 'minor = "%s"\n' "$minor"

    if [ -L "$path" ]; then
        target="$(readlink "$path" 2>/dev/null || true)"
        printf 'symlink_target = "%s"\n' "$(escape_toml "$target")"
    fi
}

emit_block_by_path() {
    path="$1"
    name="$(basename "$path")"

    printf '\n[block."%s"]\n' "$(escape_toml "$name")"
    printf 'path = "%s"\n' "$(escape_toml "$path")"
    printf 'exists = %s\n' "$( [ -b "$path" ] && printf true || printf false )"
    printf 'type = "%s"\n' "$(file_type "$path")"
    printf 'major = "%s"\n' "$(file_major "$path")"
    printf 'minor = "%s"\n' "$(file_minor "$path")"

    if have_cmd blkid && [ -b "$path" ]; then
        uuid="$(blkid -s UUID -o value "$path" 2>/dev/null || true)"
        partuuid="$(blkid -s PARTUUID -o value "$path" 2>/dev/null || true)"
        label="$(blkid -s LABEL -o value "$path" 2>/dev/null || true)"
        fstype="$(blkid -s TYPE -o value "$path" 2>/dev/null || true)"
        [ -n "$uuid" ] && printf 'uuid = "%s"\n' "$(escape_toml "$uuid")"
        [ -n "$partuuid" ] && printf 'partuuid = "%s"\n' "$(escape_toml "$partuuid")"
        [ -n "$label" ] && printf 'label = "%s"\n' "$(escape_toml "$label")"
        [ -n "$fstype" ] && printf 'fstype = "%s"\n' "$(escape_toml "$fstype")"
    else
        printf 'blkid_available = false\n'
    fi
}

emit_disk_links() {
    base="$1"
    class="$2"

    [ -d "$base" ] || return 0

    find "$base" -mindepth 1 -maxdepth 1 -type l 2>/dev/null | sort | while IFS= read -r link; do
        key="$(basename "$link")"
        target="$(readlink -f "$link" 2>/dev/null || readlink "$link" 2>/dev/null || true)"
        printf '\n[disk_link.%s."%s"]\n' "$class" "$(escape_toml "$key")"
        printf 'path = "%s"\n' "$(escape_toml "$link")"
        printf 'target = "%s"\n' "$(escape_toml "$target")"
        printf 'target_type = "%s"\n' "$(file_type "$target")"
    done
}

{
    printf '# Zalty OS technical inventory\n'
    printf '# Generated by metal-inventory v0.1\n'
    printf '\n[metadata]\n'
    printf 'schema = "zalty.metal.inventory.v0"\n'
    printf 'version = "0.1"\n'
    printf 'generated_at_utc = "%s"\n' "$(now_utc)"
    printf 'scope = "initramfs-live"\n'

    printf '\n[kernel]\n'
    printf 'release = "%s"\n' "$(escape_toml "$(uname -r 2>/dev/null || printf unknown)")"
    printf 'machine = "%s"\n' "$(escape_toml "$(uname -m 2>/dev/null || printf unknown)")"
    if [ -r /proc/cmdline ]; then
        printf 'cmdline = "%s"\n' "$(escape_toml "$(cat /proc/cmdline 2>/dev/null || true)")"
    else
        printf 'cmdline_available = false\n'
    fi

    printf '\n[filesystems]\n'
    printf 'proc_mounted = %s\n' "$(mountpoint -q /proc 2>/dev/null && printf true || printf false)"
    printf 'sys_mounted = %s\n' "$(mountpoint -q /sys 2>/dev/null && printf true || printf false)"
    printf 'dev_mounted = %s\n' "$(mountpoint -q /dev 2>/dev/null && printf true || printf false)"
    printf 'run_mounted = %s\n' "$(mountpoint -q /run 2>/dev/null && printf true || printf false)"

    emit_node 'null' '/dev/null'
    emit_node 'zero' '/dev/zero'
    emit_node 'random' '/dev/random'
    emit_node 'urandom' '/dev/urandom'
    emit_node 'console' '/dev/console'
    emit_node 'kmsg' '/dev/kmsg'

    emit_node 'mem' '/dev/mem'
    emit_node 'kmem' '/dev/kmem'
    emit_node 'port' '/dev/port'
    emit_node 'kvm' '/dev/kvm'
    emit_node 'fuse' '/dev/fuse'
    emit_node 'net_tun' '/dev/net/tun'
    emit_node 'mapper_control' '/dev/mapper/control'
    emit_node 'loop_control' '/dev/loop-control'

    if [ -d /sys/block ]; then
        find /sys/block -mindepth 1 -maxdepth 1 -type l -o -type d 2>/dev/null | sort | while IFS= read -r sysdev; do
            devname="$(basename "$sysdev")"
            [ -b "/dev/$devname" ] && emit_block_by_path "/dev/$devname"
            find "/sys/block/$devname" -mindepth 1 -maxdepth 1 -type d -name "${devname}*" 2>/dev/null | sort | while IFS= read -r part; do
                partname="$(basename "$part")"
                [ -b "/dev/$partname" ] && emit_block_by_path "/dev/$partname"
            done
        done
    fi

    emit_disk_links '/dev/disk/by-uuid' 'by_uuid'
    emit_disk_links '/dev/disk/by-partuuid' 'by_partuuid'
    emit_disk_links '/dev/disk/by-label' 'by_label'
} > "$OUT"

printf 'metal-inventory: wrote %s\n' "$OUT" >&2
